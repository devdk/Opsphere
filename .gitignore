/output/carousels/*
!/output/carousels/.gitkeep
/output/linkedin/*
!/output/linkedin/.gitkeep

# typescript
*.tsbuildinfo
next-env.d.ts

# AI-generated images (keep folder via .gitkeep)
/public/generated/*
!/public/generated/.gitkeep
