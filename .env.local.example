# Google Gemini API
GEMINI_API_KEY=

# Gmail SMTP (use a Google App Password, not your account password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
PREVIEW_EMAIL=

# Meta / Instagram Graph API
META_USER_ID=
META_ACCESS_TOKEN=

# LinkedIn API
# Fill CLIENT_ID/SECRET from your app's Auth tab, then visit
# http://localhost:3000/api/linkedin/auth to generate the token + URN.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# Hunter.io (lead email enrichment — Phase 3)
HUNTER_API_KEY=

# Cloudinary (free tier) — public image hosting required for Instagram publishing.
# Dashboard -> Settings -> Upload -> Add upload preset -> Signing Mode: "Unsigned".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# Optional but recommended: enables Meta token AUTO-REFRESH + exact expiry
# tracking (app dashboard -> Settings -> Basic).
META_APP_ID=
META_APP_SECRET=

# Optional: override the Graph API version (default v21.0).
META_GRAPH_VERSION=

# Image generation (optional). Default is the free, keyless Pollinations API.
# Override only if you self-host or use a different provider.
IMAGE_API_URL=
